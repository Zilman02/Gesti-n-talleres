// Clave de almacenamiento local en el dispositivo
const STORAGE_KEY = 'ruiz_automotores_orders';

// Cargar órdenes guardadas o iniciar lista vacía
let orders = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];

// Inicializar aplicación al abrir
document.addEventListener('DOMContentLoaded', () => {
  renderOrders();
  updateStats();
  setupNetworkStatus();
  registerServiceWorker();

  // Asegurar que el botón de descarga use la nueva función
  const btnExport = document.querySelector('button[onclick*="export"], .btn-export, #downloadExcelBtn') || 
                    Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Descargar Excel'));
  if (btnExport) {
    btnExport.onclick = exportToExcel;
  }
});

// Evento para guardar nueva orden
const form = document.getElementById('orderForm');
if (form) {
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    saveNewOrder();
  });
}

// Guardar orden en el teléfono
function saveNewOrder() {
  const clientName = document.getElementById('clientName')?.value.trim() || '';
  const clientPhone = document.getElementById('clientPhone')?.value.trim() || '';
  const vehicleModel = document.getElementById('vehicleModel')?.value.trim() || '';
  const vehiclePlate = document.getElementById('vehiclePlate')?.value.trim().toUpperCase() || '';
  const serviceDesc = document.getElementById('serviceDesc')?.value.trim() || '';
  const serviceBudget = document.getElementById('serviceBudget')?.value.trim() || '0';
  const orderStatus = document.getElementById('orderStatus')?.value || 'En Taller';

  const newOrder = {
    id: Date.now(),
    date: new Date().toLocaleDateString('es-AR'),
    clientName: clientName,
    clientPhone: clientPhone,
    vehicleModel: vehicleModel,
    vehiclePlate: vehiclePlate,
    serviceDesc: serviceDesc,
    budget: Number(serviceBudget) || 0,
    status: orderStatus
  };

  orders.unshift(newOrder);
  localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
  
  if (form) form.reset();
  renderOrders();
  updateStats();
}

// Renderizar lista de órdenes
function renderOrders() {
  const container = document.getElementById('ordersList') || document.querySelector('.orders-container');
  if (!container) return;

  container.innerHTML = '';
  orders.forEach((order) => {
    const plate = order.vehiclePlate || order.plate || 'S/P';
    const vehicle = order.vehicleModel || order.vehicle || '';
    const client = order.clientName || order.client || '';
    const phone = order.clientPhone || order.phone || '';
    const desc = order.serviceDesc || order.description || '';
    const budget = Number(order.budget) || 0;
    const status = order.status || 'En Taller';

    const card = document.createElement('div');
    card.className = 'order-card';
    card.innerHTML = `
      <div class="order-header">
        <span class="badge-plate">${plate}</span>
        <span class="badge-status">${status}</span>
      </div>
      <p><strong>Vehículo:</strong> ${vehicle} | <strong>Fecha:</strong> ${order.date}</p>
      <p><strong>Cliente:</strong> ${client} (${phone})</p>
      <p><strong>Trabajo:</strong> ${desc}</p>
      <p><strong>Presupuesto:</strong> $${budget.toLocaleString('es-AR')}</p>
      <div class="order-actions">
        <button onclick="deleteOrder(${order.id})" class="btn-delete">Eliminar</button>
      </div>
    `;
    container.appendChild(card);
  });
}

// Actualizar estadísticas de cabecera
function updateStats() {
  const totalOrdersEl = document.getElementById('statTotalOrders');
  const inRepairEl = document.getElementById('statInRepair');
  const totalRevenueEl = document.getElementById('statRevenue');

  const inRepair = orders.filter(o => o.status === 'En Taller' || o.status === 'En Reparación' || o.status === 'Pendiente').length;
  const revenue = orders.reduce((sum, o) => sum + (Number(o.budget) || 0), 0);

  if (totalOrdersEl) totalOrdersEl.textContent = orders.length;
  if (inRepairEl) inRepairEl.textContent = inRepair;
  if (totalRevenueEl) totalRevenueEl.textContent = '$' + revenue.toLocaleString('es-AR');
}

// Eliminar orden
function deleteOrder(id) {
  if (!confirm('¿Desea eliminar esta orden?')) return;
  orders = orders.filter(o => o.id !== id);
  localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
  renderOrders();
  updateStats();
}

// Exportar a Excel con columnas automáticas y formato visual
function exportToExcel() {
  if (!orders || orders.length === 0) {
    alert('No hay órdenes registradas para exportar.');
    return;
  }

  let tableHTML = `
    <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
    <head>
      <meta charset="UTF-8">
      <!--[if gte mso 9]>
      <xml>
        <x:ExcelWorkbook>
          <x:ExcelWorksheets>
            <x:ExcelWorksheet>
              <x:Name>Reporte Taller</x:Name>
              <x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>
            </x:ExcelWorksheet>
          </x:ExcelWorksheets>
        </x:ExcelWorkbook>
      </xml>
      <![endif]-->
      <style>
        table { border-collapse: collapse; width: 100%; font-family: Arial, sans-serif; }
        th { background-color: #1e3a8a; color: #ffffff; font-weight: bold; padding: 10px; border: 1px solid #cbd5e1; text-align: left; }
        td { padding: 8px; border: 1px solid #cbd5e1; text-align: left; }
        .num { text-align: right; font-weight: bold; }
        .center { text-align: center; }
        .total-row { background-color: #f1f5f9; font-weight: bold; }
      </style>
    </head>
    <body>
      <table>
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Patente</th>
            <th>Vehículo</th>
            <th>Cliente</th>
            <th>Teléfono</th>
            <th>Trabajo Realizado</th>
            <th>Presupuesto</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
  `;

  let totalFacturado = 0;

  orders.forEach(order => {
    const plate = order.vehiclePlate || order.plate || '';
    const vehicle = order.vehicleModel || order.vehicle || '';
    const client = order.clientName || order.client || '';
    const phone = order.clientPhone || order.phone || '';
    const desc = order.serviceDesc || order.description || '';
    const budget = Number(order.budget) || 0;
    const status = order.status || 'En Taller';

    totalFacturado += budget;

    tableHTML += `
      <tr>
        <td class="center">${order.date || ''}</td>
        <td class="center"><strong>${plate}</strong></td>
        <td>${vehicle}</td>
        <td>${client}</td>
        <td>${phone}</td>
        <td>${desc}</td>
        <td class="num">$${budget.toLocaleString('es-AR')}</td>
        <td class="center">${status}</td>
      </tr>
    `;
  });

  tableHTML += `
          <tr class="total-row">
            <td colspan="6" style="text-align: right;">TOTAL ACUMULADO:</td>
            <td class="num">$${totalFacturado.toLocaleString('es-AR')}</td>
            <td></td>
          </tr>
        </tbody>
      </table>
    </body>
    </html>
  `;

  // El carácter \uFEFF asegura que Excel reconozca tildes, signos de pesos y formato de tabla
  const blob = new Blob(['\uFEFF' + tableHTML], { type: 'application/vnd.ms-excel;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  
  const today = new Date().toISOString().slice(0, 10);
  link.setAttribute('href', url);
  link.setAttribute('download', `Reporte_Ruiz_Automotores_${today}.xls`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}

// Funciones auxiliares por si existen en index.html
function exportCSV() {
  exportToExcel();
}
function setupNetworkStatus() {}
function registerServiceWorker() {
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('./sw.js').catch(() => {});
  }
}
